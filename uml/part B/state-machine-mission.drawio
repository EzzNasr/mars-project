<mxfile host="app.diagrams.net"><diagram name="State Diagram - Mission lifecycle" id="State_Diagram_-_Mission_lifecycle"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="State Diagram - life cycle of one Mission (enum MissionState)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1000" height="28" as="geometry"/></mxCell><mxCell id="c3" value="Transition label = event [guard] / action.&lt;br&gt;Ask: what can happen to this Mission now?" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff9b1;strokeColor=#b8a000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="520" height="44" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="20" height="20" as="geometry"/></mxCell><mxCell id="c5" value="CREATED" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="230" width="150" height="60" as="geometry"/></mxCell><mxCell id="c6" value="ASSIGNED" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="230" width="150" height="60" as="geometry"/></mxCell><mxCell id="c7" value="IN_PROGRESS" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="230" width="170" height="60" as="geometry"/></mxCell><mxCell id="c8" value="COMPLETED" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1250" y="230" width="150" height="60" as="geometry"/></mxCell><mxCell id="c9" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1448" y="248" width="24" height="24" as="geometry"/></mxCell><mxCell id="c10" value="FAILED" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="520" width="160" height="60" as="geometry"/></mxCell><mxCell id="c11" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="940" y="538" width="24" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="submitMission&lt;br&gt;[no active mission AND environment allows AND agents capable and available AND team covers capabilities AND resources sufficient]&lt;br&gt;/ consume resources, assign agents" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1"><mxGeometry x="266" y="138" width="250" height="116" as="geometry"/></mxCell><mxCell id="c15" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="tick&lt;br&gt;/ start(), move surface agents to the surface" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1"><mxGeometry x="676" y="205" width="220" height="50" as="geometry"/></mxCell><mxCell id="c17" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.2941;exitY=0.0;exitDx=0;exitDy=0;entryX=0.7059;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="170"/><mxPoint x="1020" y="170"/></Array></mxGeometry></mxCell><mxCell id="c18" value="tick [progress &amp;lt; duration AND no failure]&lt;br&gt;/ progress++" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="96" width="300" height="70" as="geometry"/></mxCell><mxCell id="c19" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="tick [progress = duration]&lt;br&gt;/ onComplete(), release agents" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1074" y="186" width="174" height="70" as="geometry"/></mxCell><mxCell id="c21" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="550"/></Array></mxGeometry></mxCell><mxCell id="c23" value="submitMission [any check S1-S7 fails]&lt;br&gt;/ mission.fail(reason), stored in history (never becomes active, nothing consumed)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1"><mxGeometry x="196" y="440" width="330" height="104" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.1875;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="440"/><mxPoint x="740" y="440"/></Array></mxGeometry></mxCell><mxCell id="c25" value="tick | changeEnvironment | failActiveMission&lt;br&gt;[failure condition, see note]&lt;br&gt;/ mission.fail(reason), release agents" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="258" height="100" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.8125;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="440"/><mxPoint x="840" y="440"/></Array></mxGeometry></mxCell><mxCell id="c27" value="tick | changeEnvironment | failActiveMission&lt;br&gt;[failure condition, see note]&lt;br&gt;/ mission.fail(reason), release agents" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1"><mxGeometry x="995" y="330" width="230" height="100" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="Failure conditions (note): dust storm while a surface (rover) mission runs; communication lost during a rescue; an assigned agent becomes unusable (battery 0, damaged, too injured, exhausted); rover breakdown (failActiveMission); target laboratory no longer operational." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff9b1;strokeColor=#b8a000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="480" width="480" height="96" as="geometry"/></mxCell><mxCell id="c30" value="FAILED and COMPLETED are final - a failed mission is never retried; create a new Mission." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff9b1;strokeColor=#b8a000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="640" width="560" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>