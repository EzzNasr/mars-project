ing is aborted (D-06)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff9b1;strokeColor=#b8a000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="188" width="330" height="34" as="geometry"/></mxCell><mxCell id="c14" value="submitMission(explorationMission, agents)" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="260" as="sourcePoint"/><mxPoint x="355" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="getState()   (S0)" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="292" as="sourcePoint"/><mxPoint x="875" y="292" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="CREATED" style="html=1;rounded=0;endArrow=open;endFill=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="316" as="sourcePoint"/><mxPoint x="365" y="316" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="S1-S2 pass: no active mission, agents given." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff9b1;strokeColor=#b8a000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="332" width="330" height="34" as="geometry"/></mxCell><mxCell id="c19" value="getCondition()" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="380" as="sourcePoint"/><mxPoint x="605" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="DUST_STORM" style="html=1;rounded=0;endArrow=open;endFill=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="404" as="sourcePoint"/><mxPoint x="365" y="404" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="getStartBlockReason(DUST_STORM)   (S3)" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="430" as="sourcePoint"/><mxPoint x="875" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value='"Surface operations are not allowed during a dust storm"' style="html=1;rounded=0;endArrow=open;endFill=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="454" as="sourcePoint"/><mxPoint x="365" y="454" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="[reason is not null]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="476" width="900" height="20" as="geometry"/></mxCell><mxCell id="c26" value="fail(reason)" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="514" as="sourcePoint"/><mxPoint x="875" y="514" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="Mission state: CREATED -&amp;gt; FAILED" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff9b1;strokeColor=#b8a000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="536" width="280" height="34" as="geometry"/></mxCell><mxCell id="c29" value="rejected(reason)" style="html=1;rounded=0;endArrow=open;endFill=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" edge="1" paren