        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class MissionType { &lt;&lt;enumeration&gt;&gt; }\n    class MissionState { &lt;&lt;enumeration&gt;&gt; }\n    class EmergencyType { &lt;&lt;enumeration&gt;&gt; }\n    class EmergencyState { &lt;&lt;enumeration&gt;&gt; }\n\n    class ResourceRequirement {\n        -amounts : Map~ResourceType, Integer~\n        +with(ResourceType type, int amount) ResourceRequirement\n        +get(ResourceType type) int\n        +asMap() Map~ResourceType, Integer~\n        +isEmpty() boolean\n        +toString() String\n    }\n\n    class Mission {\n        &lt;&lt;interface&gt;&gt;\n        +String RESPONSIBILITY = \&quot;Represents a task assigned to colony agents.\&quot;\n        +getId() String\n        +getType() MissionType\n        +getState() MissionState\n        +getDurationUnits() int\n        +getProgressUnits() int\n        +getFailureReason() String\n        +getAssignedAgents() List~Agent~\n        +getTargetFacilities() List~Facility~\n        +getResourceRequirement() ResourceRequirement\n        +getRequiredCapabilities() Set~Capability~\n        +getRequiredSkill() Skill\n        +getMinBatteryPercent() int\n        +getRequiredEquipment() List~String~\n        +requiresCommunication() boolean\n        +requiresSurface() boolean\n        +getStartBlockReason(EnvironmentCondition env) String\n        +getInProgressFailureReason(EnvironmentCondition env) String\n        +assign(List~Agent~ agents) void\n        +start() void\n        +advance() void\n        +fail(String reason) void\n        +isFinished() boolean\n        +describe() String\n    }\n\n    class AbstractMission {\n        &lt;&lt;abstract&gt;&gt;\n        -id : String\n        -type : MissionType\n        -durationUnits : int\n        -state : MissionState\n        -progressUnits : int\n        -failureReason : String\n        -assignedAgents : List~Agent~\n        -targetFacilities : List~Facility~\n        -resourceRequirement : ResourceRequirement\n        #AbstractMission(...)\n        #onComplete() void\n    }\n    Mission &lt;|.. AbstractMission\n\n    class ExplorationMission {\n        -regionName : String\n        +ExplorationMission(...)\n        +getRegionName() String\n    }\n    class RepairMission {\n        +RepairMission(...)\n    }\n    class ResearchMission {\n        +ResearchMission(...)\n    }\n    class RescueMission {\n        +RescueMission(...)\n    }\n    AbstractMission &lt;|-- ExplorationMission\n    AbstractMission &lt;|-- RepairMission\n    AbstractMission &lt;|-- ResearchMission\n    AbstractMission &lt;|-- RescueMission\n\n    class AllocationPolicy {\n        &lt;&lt;interface&gt;&gt;\n        +order(List~Facility~ operationalFacilities, ResourceType type) List~Facility~\n    }\n    class StorageFirstPolicy {\n        +order(List~Facility~ operationalFacilities, ResourceType type) List~Facility~\n    }\n    AllocationPolicy &lt;|.. StorageFirstPolicy\n\n    class SubmissionResult {\n        +accepted(Mission mission)$ SubmissionResult\n        +rejected(Mission mission, String reason)$ SubmissionResult\n        +isAccepted() boolean\n        +getReason() String\n        +getMission() Mission\n        +toString() String\n    }\n\n    class ResourceManager {\n        +String RESPONSIBILITY = \&quot;Manages facility inventory and resource consumption.\&quot;\n        -facilities : List~Facility~\n        -policy : AllocationPolicy\n        +ResourceManager(List~Facility~ facilities, AllocationPolicy policy)\n        +setPolicy(AllocationPolicy policy) void\n        +getTotal(ResourceType type) int\n        +getAllTotals() Map~ResourceType, Integer~\n        +canSupply(ResourceRequirement requirement) boolean\n        +explainShortage(ResourceRequirement requirement) String\n        +consume(ResourceRequirement requirement) boolean\n    }\n    ResourceManager --&gt; AllocationPolicy\n\n    class MarsColony {\n        +String RESPONSIBILITY = \&quot;Core colony hub coordinating resources and missions.\&quot;\n        -name : String\n        -agents : List~Agent~\n        -facilities : List~Facility~\n        -resourceManager : ResourceManager\n        -environment : Environment\n        -activeMission : Mission\n        -missionHistory : List~Mission~\n        -eventLog : List~String~\n        +MarsColony(String name, AllocationPolicy policy)\n        +MarsColony(String name)\n        +getName() String\n        +addAgent(Agent agent) void\n        +addFacility(Facility facility) void\n        +getAgents() List~Agent~\n        +getFacilities() List~Facility~\n        +findFacility(String name) Facility\n        +findAgent(String id) Agent\n        +getAgentsAt(Location location) List~Agent~\n        +hasOperationalCommunication() boolean\n        +getEnvironment() Environment\n        +getResourceManager() ResourceManager\n        +submitMission(Mission mission, List~Agent~ agents) SubmissionResult\n        +getActiveMission() Mission\n        +getMissionHistory() List~Mission~\n        +failActiveMission(String reason) boolean\n        +changeEnvironment(EnvironmentCondition condition) void\n        +tick() void\n        +log(String message) void\n        +getEventLog() List~String~\n    }\n    MarsColony *-- ResourceManager\n\n    class Emergency {\n        &lt;&lt;abstract&gt;&gt;\n        +String RESPONSIBILITY = \&quot;Critical event requiring immediate response and resources.\&quot;\n        -id : String\n        -type : EmergencyType\n        -location : Location\n        -state : EmergencyState\n        -reason : String\n        -responders : List~Agent~\n        #Emergency(String id, EmergencyType type, Location location)\n        +getId() String\n        +getType() EmergencyType\n        +getLocation() Location\n        +getState() EmergencyState\n        +getReason() String\n        +getResponders() List~Agent~\n        +describe() String\n        +getRequiredResponderCapabilities()* List~Capability~\n        +getResponseResources()* ResourceRequirement\n        #applyInitialEffects(MarsColony colony)* void\n        #applyResolution(MarsColony colony)* void\n        #applyUnresolvedPenalty(MarsColony colony)* void\n        #checkPreconditions(MarsColony colony) String\n        #isExcluded(Agent agent) boolean\n        ~setState(EmergencyState state, String reason) void\n        ~addResponder(Agent agent) void\n    }\n\n    class OxygenLeak {\n        +OxygenLeak(String id, Habitat habitat, int oxygenLoss)\n    }\n    class Fire {\n        +Fire(String id, Laboratory lab)\n    }\n    class RoverBreakdown {\n        +RoverBreakdown(String id, ExplorationRover rover)\n    }\n    class MedicalEmergency {\n        +MedicalEmergency(String id, CrewMember patient, int severity)\n    }\n    Emergency &lt;|-- OxygenLeak\n    Emergency &lt;|-- Fire\n    Emergency &lt;|-- RoverBreakdown\n    Emergency &lt;|-- MedicalEmergency\n\n    class EmergencyManager {\n        -colony : MarsColony\n        -history : List~Emergency~\n        +EmergencyManager(MarsColony colony)\n        +handle(Emergency emergency) Emergency\n        +getHistory() List~Emergency~\n        +getUnresolved() List~Emergency~\n    }\n\n    class Simulation {\n        +String RESPONSIBILITY = \&quot;Time management engine for the colony ecosystem.\&quot;\n        -colony : MarsColony\n        -emergencyManager : EmergencyManager\n        -currentTime : int\n        -envChanges : List~ScheduledEnvChange~\n        -emergencies : List~ScheduledEmergency~\n        +Simulation(MarsColony colony)\n        +getColony() MarsColony\n        +getEmergencyManager() EmergencyManager\n        +getCurrentTime() int\n        +scheduleEnvironmentChange(int atTime, EnvironmentCondition condition) void\n        +scheduleEmergency(int atTime, Emergency emergency) void\n        +triggerEmergency(Emergency emergency) void\n        +advanceTime(int units) void\n        +advanceOneUnit() void\n        +report() String\n    }\n    Simulation *-- EmergencyManager\n    Simulation --&gt; MarsColony\n\n    %% External Stubs for Cross-Relationships\n    class Agent { &lt;&lt;interface&gt;&gt; }\n    class Facility { &lt;&lt;abstract&gt;&gt; }\n    class Location { &lt;&lt;interface&gt;&gt; }\n    class Environment\n\n    MarsColony o-- \&quot;1..*\&quot; Agent\n    MarsColony o-- \&quot;1..*\&quot; Facility\n    MarsColony *-- Environment\n    MarsColony --&gt; \&quot;0..1\&quot; Mission : activeMission\n\n    AbstractMission --&gt; \&quot;0..*\&quot; Agent : assignedAgents\n    AbstractMission --&gt; \&quot;0..*\&quot; Facility : targetFacilities\n\n    Emergency --&gt; \&quot;0..*\&quot; Agent : responders\n    Emergency --&gt; Location : location&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="EImfaG6CGP1vd2e662rK-240">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
