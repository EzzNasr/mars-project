<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="U-mT2ts_ejgL20J42hlM">
    <mxGraphModel dx="1296" dy="1098" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Capability { &lt;&lt;enumeration&gt;&gt; }\n    class Skill { &lt;&lt;enumeration&gt;&gt; }\n    class ResourceType { &lt;&lt;enumeration&gt;&gt; }\n    class FacilityStatus { &lt;&lt;enumeration&gt;&gt; }\n    class RobotCondition { &lt;&lt;enumeration&gt;&gt; }\n    class EnvironmentCondition { &lt;&lt;enumeration&gt;&gt; }\n\n    class Location {\n        &lt;&lt;interface&gt;&gt;\n        +getName() String\n    }\n\n    class MartianSurface {\n        +INSTANCE : MartianSurface$\n        -MartianSurface()\n        +getName() String\n        +toString() String\n    }\n    Location &lt;|.. MartianSurface\n\n    class Equipment {\n        -name : String\n        -functional : boolean\n        +Equipment(String name)\n        +getName() String\n        +isFunctional() boolean\n        +damage() void\n        +repair() void\n        +toString() String\n    }\n\n    class Agent {\n        &lt;&lt;interface&gt;&gt;\n        +String RESPONSIBILITY = \&quot;Anything assigned to missions/emergencies\&quot;\n        +getId() String\n        +getName() String\n        +getLocation() Location\n        +setLocation(Location location) void\n        +getHomeLocation() Location\n        +getCapabilities() Set~Capability~\n        +hasCapability(Capability c) boolean\n        +getUnusableReason() String\n        +isUsable() boolean\n        +isAssigned() boolean\n        +assignToMission() void\n        +release() void\n        +isAvailable() boolean\n        +getCannotPerformReason(Mission mission) String\n        +canPerform(Mission mission) boolean\n        +canHandle(EmergencyType type) boolean\n        +isRemoteControlled() boolean\n        +takeDamage(int amount) void\n        +recover(int amount) void\n        +tick() void\n        +describe() String\n    }\n\n    class CrewMember {\n        &lt;&lt;abstract&gt;&gt;\n        +UNUSABLE_HEALTH_AT_OR_BELOW : int$\n        +FATIGUE_LIMIT : int$\n        +FATIGUE_PER_TICK : int$\n        +REST_PER_TICK : int$\n        -id : String\n        -name : String\n        -home : Location\n        -location : Location\n        -skills : Set~Skill~\n        -health : int\n        -fatigue : int\n        -assigned : boolean\n        #CrewMember(String id, String name, Location home, Set~Skill~ skills)\n        +getHealth() int\n        +getFatigue() int\n        +getSkills() Set~Skill~\n        +hasSkill(Skill skill) boolean\n        +performDuty()* String\n        #lacksCapabilityReason() String\n    }\n    Agent &lt;|.. CrewMember\n\n    class Scientist {\n        +Scientist(String id, String name, Location home, Set~Skill~ skills)\n        +performDuty() String\n    }\n    class Engineer {\n        +Engineer(String id, String name, Location home, Set~Skill~ skills)\n        +performDuty() String\n        +repair(Mission mission) String\n    }\n    class MedicalOfficer {\n        +MedicalOfficer(String id, String name, Location home, Set~Skill~ skills)\n        +performDuty() String\n    }\n    CrewMember &lt;|-- Scientist\n    CrewMember &lt;|-- Engineer\n    CrewMember &lt;|-- MedicalOfficer\n\n    class Robot {\n        &lt;&lt;abstract&gt;&gt;\n        +DAMAGE_THRESHOLD : int$\n        +IDLE_RECHARGE : int$\n        -id : String\n        -name : String\n        -home : Location\n        -location : Location\n        -battery : int\n        -condition : RobotCondition\n        -assigned : boolean\n        #Robot(String id, String name, Location home, int battery)\n        +getBattery() int\n        +drain(int amount) void\n        +recharge(int amount) void\n        +getCondition() RobotCondition\n        +damage() void\n        +repair() void\n        #getDrainPerTick()* int\n        +performFunction()* String\n        #lacksCapabilityReason() String\n        #batteryReason(Mission m) String\n    }\n    Agent &lt;|.. Robot\n\n    class ExplorationRover {\n        -cargo : List~Equipment~\n        +ExplorationRover(String id, String name, Location home, int battery)\n        +ExplorationRover(String id, String name, Location home)\n        +loadEquipment(Equipment e) void\n        +getCargo() List~Equipment~\n        +hasEquipment(String equipmentName) boolean\n        +performFunction() String\n    }\n    class RepairRobot {\n        +RepairRobot(String id, String name, Location home, int battery)\n        +RepairRobot(String id, String name, Location home)\n        +performFunction() String\n    }\n    class Drone {\n        +Drone(String id, String name, Location home, int battery)\n        +Drone(String id, String name, Location home)\n        +performFunction() String\n    }\n    Robot &lt;|-- ExplorationRover\n    Robot &lt;|-- RepairRobot\n    Robot &lt;|-- Drone\n\n    class ResourceInventory {\n        +get(ResourceType type) int\n        +add(ResourceType type, int amount) void\n        +remove(ResourceType type, int amount) boolean\n        +removeUpTo(ResourceType type, int amount) int\n        +total() int\n        +snapshot() Map~ResourceType, Integer~\n    }\n\n    class Facility {\n        &lt;&lt;abstract&gt;&gt;\n        +String RESPONSIBILITY = \&quot;Building storing resources and equipment.\&quot;\n        -name : String\n        -capacity : int\n        -status : FacilityStatus\n        -inventory : ResourceInventory\n        -equipment : List~Equipment~\n        #Facility(String name, int capacity)\n        +getName() String\n        +getCapacity() int\n        +getStatus() FacilityStatus\n        +setStatus(FacilityStatus status) void\n        +isOperational() boolean\n        +getStored(ResourceType type) int\n        +getAvailable(ResourceType type) int\n        +getTotalStored() int\n        +store(ResourceType type, int amount) boolean\n        +withdraw(ResourceType type, int amount) boolean\n        +lose(ResourceType type, int amount) int\n        +addEquipment(Equipment e) void\n        +getEquipment() List~Equipment~\n        +findEquipment(String equipmentName) Equipment\n        +getKind()* String\n        +describe() String\n        +toString() String\n    }\n    Location &lt;|.. Facility\n    Facility *-- ResourceInventory\n    Facility o-- \&quot;0..*\&quot; Equipment\n\n    class LifeSupportSystem {\n        -functional : boolean\n        +isFunctional() boolean\n        +setFunctional(boolean functional) void\n        +describe() String\n    }\n\n    class Habitat {\n        -lifeSupport : LifeSupportSystem\n        -leaking : boolean\n        +Habitat(String name, int capacity)\n        +getLifeSupport() LifeSupportSystem\n        +isLeaking() boolean\n        +setLeaking(boolean leaking) void\n        +loseOxygen(int amount) int\n        +getKind() String\n    }\n    Facility &lt;|-- Habitat\n    Habitat *-- LifeSupportSystem\n\n    class Laboratory {\n        -onFire : boolean\n        +Laboratory(String name, int capacity)\n        +isOnFire() boolean\n        +setOnFire(boolean onFire) void\n        +damageAllEquipment() void\n        +hasFunctionalEquipment(String equipmentName) boolean\n        +getKind() String\n    }\n    Facility &lt;|-- Laboratory\n\n    class StorageFacility {\n        +StorageFacility(String name, int capacity)\n        +getKind() String\n    }\n    Facility &lt;|-- StorageFacility\n\n    class PowerStation {\n        -outputUnits : int\n        +PowerStation(String name, int capacity, int outputUnits)\n        +getOutputUnits() int\n        +getKind() String\n    }\n    Facility &lt;|-- PowerStation\n\n    class CommunicationStation {\n        +CommunicationStation(String name, int capacity)\n        +isLinkUp() boolean\n        +getKind() String\n    }\n    Facility &lt;|-- CommunicationStation\n\n    class Environment {\n        -condition : EnvironmentCondition\n        +getCondition() EnvironmentCondition\n        +setCondition(EnvironmentCondition condition) void\n        +isNormal() boolean\n        +isDustStorm() boolean\n        +isCommunicationDisrupted() boolean\n        +describe() String\n    }\n\n    class ColonyReport {\n        -ColonyReport()\n        +build(MarsColony colony, int currentTime, List~Emergency~ emergencies)$ String\n    }\n\n    class Mission { &lt;&lt;interface&gt;&gt; }\n    Engineer --&gt; Mission : repair(Mission)\n    ExplorationRover o-- \&quot;0..*\&quot; Equipment&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="9e0MyN_wXzQB47vVw1nH-1136">
